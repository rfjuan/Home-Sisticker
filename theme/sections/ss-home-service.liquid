{%- comment -%} SS · Home — Confianza comercial (envío, devoluciones, soporte) {%- endcomment -%}

<div class="ss-pdp ss-home ss-h-service">
  <div class="ss-wrap">
    <div class="ss-h-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ss-h-kicker">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="ss-h-title">
        {{ section.settings.title }}
        {%- if section.settings.title_accent != blank %}
          <span class="ss-serif">{{ section.settings.title_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="ss-h-service__grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'card' -%}{%- continue -%}{%- endif -%}
        <article class="ss-h-service__card" {{ block.shopify_attributes }}>
          <div class="ss-h-service__ico">
            {% render 'ss-icon', name: block.settings.icon, size: 18, stroke: 1.9 %}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}">
              {{ block.settings.link_label }}
              {% render 'ss-icon', name: 'arrow-down', size: 12, stroke: 2.6 %}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Inicio · Confianza",
  "tag": "section",
  "class": "ss-home-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Compra con calma"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Lo que puedes esperar"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Parte destacada en cursiva",
      "default": "de tu pedido."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Descripción",
      "default": "Envíos solo a España, seguimiento por email y atención directa desde tienda@minirueda.com."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Camión" },
            { "value": "refresh", "label": "Devoluciones" },
            { "value": "heart", "label": "Atención" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "box", "label": "Paquete" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío a toda España"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Preparamos tu pedido en 24–72 h laborables y te enviamos el seguimiento por email."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace",
          "default": "Política de envío"
        },
        {
          "type": "text",
          "id": "link_url",
          "label": "Enlace",
          "info": "Admite rutas (/policies/...) y mailto:."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inicio · Confianza"
    }
  ]
}
{% endschema %}
