{% comment %}
  MiniRueda storefront landing redirect.
  Redirect only the root homepage, never the product, cart, or contact pages.
{% endcomment %}
{% assign target_product = all_products['drink-spike-test-nail-stickers-discreet-drink-test-strips-for-night-out-party-safety-heart-shape-nail-art-detection-stickers-10'] %}
{% assign target_url = target_product.url %}
{% if target_url == blank %}
  {% assign target_url = '/products/drink-spike-test-nail-stickers-discreet-drink-test-strips-for-night-out-party-safety-heart-shape-nail-art-detection-stickers-10' %}
{% endif %}
<div class="ss-home-redirect" style="min-height:40vh;display:flex;justify-content:center;align-items:center;padding:40px;text-align:center">
  <p>Ir directamente al <a href="{{ target_url }}">producto de MiniRueda</a>.</p>
</div>
<script>
  (function () {
    var url = {{ target_url | json }};
    var params = new URLSearchParams(window.location.search);
    var preview = params.get('preview_theme_id');
    if (preview) url += (url.indexOf('?') === -1 ? '?' : '&') + 'preview_theme_id=' + encodeURIComponent(preview);
    window.location.replace(url);
  })();
</script>
<noscript>
  <meta http-equiv="refresh" content="0;url={{ target_url | escape }}">
</noscript>
{% schema %}
{
  "name": "Acceso directo a PDP",
  "settings": [],
  "presets": [{ "name": "Acceso directo a PDP" }]
}
{% endschema %}
