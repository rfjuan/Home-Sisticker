{%- doc -%}
  Renders an inline SVG icon from the SS PDP icon set.

  @param {string} name - Icon key (info, clock, heart, bag, shield, shield-check, truck, lock, refresh, chevron, check, cross, arrows, play, arrow-down, box, flask, tote, star, gift)
  @param {number} [size] - Width/height in px. Default 20.
  @param {number} [stroke] - Stroke width. Default 1.8.
  @param {string} [class] - Extra CSS classes.
  @param {string} [color] - Optional stroke/fill color. Defaults to currentColor.
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 20
  assign icon_stroke = stroke | default: 1.8
  assign icon_color = color | default: 'currentColor'
-%}

<svg
  class="ss-icon{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  {% if name == 'play' %}
    fill="{{ icon_color }}"
  {% else %}
    fill="none" stroke="{{ icon_color }}"
  {% endif %}
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16.5h.01"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/>
    {%- when 'heart' -%}
      <path d="M12 21s-7.5-4.6-9.5-9C1 8.5 3 5 6.5 5c2 0 3.5 1 4.5 2.5C12 6 13.5 5 15.5 5 19 5 21 8.5 20.5 12c-.5 4.4-8.5 9-8.5 9z"/>
    {%- when 'bag' -%}
      <path d="M6 8h12l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.3H8.7a1.5 1.5 0 0 1-1.5-1.3L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/>
    {%- when 'shield-check' -%}
      <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'lock' -%}
      <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- when 'refresh' -%}
      <path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'check' -%}
      <path d="M5 13l4 4L19 7"/>
    {%- when 'cross' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'arrows' -%}
      <path d="M8 7l-4 5 4 5M16 7l4 5-4 5"/>
    {%- when 'play' -%}
      <path d="M8 5v14l11-7z"/>
    {%- when 'arrow-down' -%}
      <path d="M12 5v14M5 12l7 7 7-7"/>
    {%- when 'box' -%}
      <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>
    {%- when 'flask' -%}
      <path d="M9 3h6M10 3v6.5L4.5 19a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 9.5V3"/><path d="M7.5 15h9"/>
    {%- when 'tote' -%}
      <path d="M4 11V7a8 8 0 0 1 16 0v4"/><path d="M3 11h18v6a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-6z"/><path d="M12 15v2"/>
    {%- when 'star' -%}
      <path d="M12 3l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.5-4.4 2.5 1-5L4.9 8.2l5-.6L12 3z"/>
    {%- when 'sparkles' -%}
      <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/><path d="M18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2z"/><path d="M5 15l.6 1.6L7.2 17.2l-1.6.6L5 19.4l-.6-1.6L2.8 17.2l1.6-.6L5 15z"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="5" rx="1"/><path d="M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M12 8v13"/><path d="M12 8S9.5 3 7.5 4.5 9 8 12 8s3.5-3.5 1.5-4.5S12 8 12 8z"/>
  {%- endcase -%}
</svg>
